# Doxygen config for the whole opensc project.
# Covers the genuine secure-component reimplementation (secure_component.c)
# and the UPI Lite / Lite X wallet public API (lite/include/lite).
# Run from the repo root with `make docs`.

PROJECT_NAME           = "opensc"
PROJECT_BRIEF          = "NPCI secure-component & UPI Lite / Lite X wallet reimplementation"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = doc/usage.md \
                         secure_component.c \
                         lite/include/lite \
                         python/opensc_lite.py \
                         python/secure_component.py
FILE_PATTERNS          = *.c *.h *.py *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = doc/usage.md

# Document every public declaration; warn on anything left undocumented so
# a gap fails the build-docs check rather than passing silently.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES

# The Python reference (opensc_lite.py) documents its public surface; the _-prefixed
# helpers and private attributes are internal and excluded from the API docs.
EXCLUDE_SYMBOLS        = _*
TYPEDEF_HIDES_STRUCT   = YES
QUIET                  = YES

# doxygen-awesome-css theme, vendored at third_party/doxygen-awesome-css.
# HTML_COLORSTYLE=LIGHT is required; the theme ships its own dark mode.
GENERATE_HTML          = YES
GENERATE_MAN           = YES
GENERATE_LATEX         = NO

GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = header.html
HTML_EXTRA_STYLESHEET  = third_party/doxygen-awesome-css/doxygen-awesome.css \
                         third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only.css \
                         third_party/doxygen-awesome-css/doxygen-awesome-sidebar-only-darkmode-toggle.css
HTML_EXTRA_FILES       = third_party/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-interactive-toc.js \
                         third_party/doxygen-awesome-css/doxygen-awesome-tabs.js
